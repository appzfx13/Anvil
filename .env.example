# ==============================================================================
# ANVIL - PRECISION INDIAN DERIVATIVE EXECUTION SANDBOX
# ==============================================================================

# Application Environment
ENV=development
DEBUG=True
SECRET_KEY=anvil-secure-crypto-key-replace-in-production-2026-xyz987

# Unique Non-Colliding Host Ports (Dedicated 85xx block)
# Host exposed ports:
NGINX_PORT=8500
NGROK_WEB_PORT=8540
FRONTEND_PORT=8573
BACKEND_PORT=8501
ENGINE_PORT=8588
POSTGRES_HOST_PORT=8532
REDIS_HOST_PORT=8579

# Ngrok Ingress Authtoken (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Internal Container Ports
POSTGRES_PORT=5432
REDIS_PORT=6379

# PostgreSQL Database Configuration
POSTGRES_DB=anvil_db
POSTGRES_USER=anvil_user
POSTGRES_PASSWORD=anvil_secure_password
POSTGRES_HOST=db

# Redis Broker Configuration
REDIS_HOST=redis
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# FYERS Broker API v3 Credentials (Real-Time Market Data)
# Leave blank to use High-Fidelity Synthetic Simulation engine
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
FYERS_FEED_ACTIVE=True

# Gmail SMTP Email OTP Credentials (Defaults to console if empty)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="ANVIL Sandbox <no-reply@anvil.local>"

# Google SSO OAuth2 Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dhan Postback / Webhook Target (e.g., Marmot or custom strategy server)
POSTBACK_WEBHOOK_URL=http://backend:8000/api/v2/postback/
POSTBACK_ENABLED=True

# Default Virtual Trading Ledger
DEFAULT_SOD_BALANCE=0.00
MAX_ORDER_QUANTITY_LIMIT=10000
